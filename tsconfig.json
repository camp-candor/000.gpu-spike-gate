{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "lib": ["ESNext", "DOM"],
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["node"],
        "noEmit": true
    },
    "exclude": ["./node_modules", "./dist", "./scratch/*"],
    "include": ["./*.ts", "./src/**/*.ts", "./**/*.test.ts"]
}
